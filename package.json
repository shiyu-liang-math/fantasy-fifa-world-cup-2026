{
  "name": "fantasy-fifa-world-cup-2026",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:db-equivalence": "vitest run src/data/reference/database-seed-equivalence.test.ts",
    "test:bootstrap": "node scripts/test-guarded-bootstrap.mjs",
    "db:reset": "supabase db reset",
    "db:verify": "npm run db:reset && npm run test:db && npm run test:db-equivalence && npm run test:bootstrap",
    "data:official:generate": "node scripts/generate-official-bootstrap.mjs",
    "data:official:check": "node scripts/generate-official-bootstrap.mjs --check",
    "data:official:apply-reviewed": "node --conditions=react-server --import tsx scripts/apply-official-reviewed-bootstrap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.5",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
