NEXT_PUBLIC_APP_URL=

# Server-only public Supabase read configuration. Use the local values printed
# by `npx supabase status` for development. Never add a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only HMAC key for signed administrator review envelopes. Use at least
# 32 bytes of unpredictable secret material. Never expose this as NEXT_PUBLIC_.
ADMIN_PREVIEW_SIGNING_SECRET=
